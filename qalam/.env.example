# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to run on the embedded PGlite database in ./data/pg
# (zero setup). Set it to a Postgres/Supabase connection string for deployment.
DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# Secret used to sign session cookies and file URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string

# Production bootstrap: the tutor account is created from these on first run
# (the demo seed is NOT used in production).
TUTOR_EMAIL=nabil@example.com
TUTOR_NAME=Nabil
TUTOR_INITIAL_PASSWORD=change-me-on-first-login

# --- Feature flags ----------------------------------------------------------
# Show "Log in as Tutor / Parent / Student" buttons on the login page.
DEMO_LOGINS=true
# LLM drafting of report text (provider-agnostic; off by default).
AI_DRAFTING=false

# --- Files ------------------------------------------------------------------
# Local upload directory (used when no object storage is configured).
UPLOAD_DIR=./data/uploads
