# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to run on the embedded PGlite database in ./data/pg
# (zero setup). Set it to a Postgres/Supabase connection string for deployment.
DATABASE_URL=

# --- Auth -----------------------------------------------------------------
# Secret used to sign short-lived file URLs (sessions use random database tokens). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Production bootstrap: the tutor account is created from these on first run
# (the demo seed is NOT used in production).
TUTOR_EMAIL=nabil@example.com
TUTOR_NAME=Nabil
TUTOR_INITIAL_PASSWORD=change-me-on-first-login

# --- Feature flags ----------------------------------------------------------
# Show "Log in as Tutor / Parent / Student" buttons on the login page.
DEMO_LOGINS=false
# LLM drafting of report text (provider-agnostic; off by default).
AI_DRAFTING=false

# --- Files ------------------------------------------------------------------
# Local development only; production requires all three Supabase settings below.
UPLOAD_DIR=./data/uploads

# Server-only credentials. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# Set SUPABASE_STORAGE_BUCKET=qalam-uploads for production.
